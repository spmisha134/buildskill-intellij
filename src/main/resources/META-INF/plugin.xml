<idea-plugin>
    <id>com.spmisha134.skillops</id>
    <name>SkillOps</name>
    <vendor email="spmisha134@gmail.com"
            url="https://github.com/spmisha134/skillOps-intellij">Sollymanul Islam</vendor>
    <description><![CDATA[
        <p><strong>Create reliable, repository-scoped skills for Codex, Claude Code, and Gemini CLI without leaving IntelliJ IDEA.</strong></p>
        <p>SkillOps removes the repetitive setup from skill authoring and helps you understand how Codex, Claude, and Gemini sessions use context and tokens.</p>
        <ul>
            <li>Create platform-specific skills with structured <code>SKILL.md</code> content and supporting references.</li>
            <li>Copy and convert repository skills between Codex, Claude Code, and Gemini CLI.</li>
            <li>Generate optional scripts and assets, plus Codex interface metadata.</li>
            <li>Validate Codex skills before committing them.</li>
            <li>Review local Codex, Claude, and Gemini run history, token usage, cache behavior, efficiency, and sessions without skills.</li>
            <li>Search and resume previous project Codex sessions in a new IntelliJ terminal.</li>
        </ul>
        <p><strong>Private by design:</strong> generation, validation, and session analysis run locally. SkillOps does not upload project files, prompts, session logs, credentials, or analytics.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable id="com.spmisha134.skillops.insights.settings"
                                 displayName="SkillOps Insights"
                                 instance="com.spmisha134.skillops.insights.settings.SkillOpsInsightsConfigurable"/>
    </extensions>

    <actions>
        <group id="com.spmisha134.skillops.ToolsGroup"
               text="SkillOps"
               popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>
        <group id="com.spmisha134.skillops.CodexGroup" text="Codex" popup="true">
            <add-to-group group-id="com.spmisha134.skillops.ToolsGroup" anchor="last"/>
        </group>
        <group id="com.spmisha134.skillops.ClaudeGroup" text="Claude" popup="true">
            <add-to-group group-id="com.spmisha134.skillops.ToolsGroup" anchor="last"/>
        </group>
        <group id="com.spmisha134.skillops.GeminiGroup" text="Gemini" popup="true">
            <add-to-group group-id="com.spmisha134.skillops.ToolsGroup" anchor="last"/>
        </group>
        <action id="com.spmisha134.skillops.CopySkills"
                class="com.spmisha134.skillops.actions.CopySkillsAction"
                text="Copy Skills"
                description="Convert repository skills from one supported platform to another."
                icon="com.spmisha134.skillops.ui.icons.SkillOpsIcons.ACTION">
            <add-to-group group-id="com.spmisha134.skillops.ToolsGroup" anchor="last"/>
        </action>
        <action id="com.spmisha134.skillops.NewSkillOps"
                class="com.spmisha134.skillops.actions.CreateSkillAction"
                text="Create Skill"
                description="Create a new Codex skill under .agents/skills."
                icon="com.spmisha134.skillops.ui.icons.SkillOpsIcons.ACTION">
            <add-to-group group-id="NewGroup" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="com.spmisha134.skillops.CodexGroup" anchor="last"/>
        </action>
        <action id="com.spmisha134.skillops.CreateClaudeSkill"
                class="com.spmisha134.skillops.actions.CreateClaudeSkillAction"
                text="Create Skill"
                description="Create a Claude Code skill under .claude/skills."
                icon="com.spmisha134.skillops.ui.icons.SkillOpsIcons.ACTION">
            <add-to-group group-id="com.spmisha134.skillops.ClaudeGroup" anchor="last"/>
        </action>
        <action id="com.spmisha134.skillops.CreateGeminiSkill"
                class="com.spmisha134.skillops.actions.CreateGeminiSkillAction"
                text="Create Skill"
                description="Create a Gemini CLI skill under .gemini/skills."
                icon="com.spmisha134.skillops.ui.icons.SkillOpsIcons.ACTION">
            <add-to-group group-id="com.spmisha134.skillops.GeminiGroup" anchor="last"/>
        </action>
        <action id="com.spmisha134.skillops.ValidateSkillOps"
                class="com.spmisha134.skillops.actions.ValidateSkillAction"
                text="Validate SkillOps"
                description="Validate a Codex skill folder."
                icon="com.spmisha134.skillops.ui.icons.SkillOpsIcons.ACTION">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="com.spmisha134.skillops.ShowRunInsights"
                class="com.spmisha134.skillops.actions.ShowRunInsightsAction"
                text="Show Run Insights"
                description="Show token usage and efficiency metrics from recent Codex sessions."
                icon="com.spmisha134.skillops.ui.icons.SkillOpsIcons.ACTION">
            <add-to-group group-id="com.spmisha134.skillops.CodexGroup" anchor="last"/>
        </action>
        <action id="com.spmisha134.skillops.ResumeCodexSession"
                class="com.spmisha134.skillops.actions.ResumeCodexSessionAction"
                text="Resume Session"
                description="Find and resume a previous project Codex session in a new terminal."
                icon="com.spmisha134.skillops.ui.icons.SkillOpsIcons.ACTION">
            <add-to-group group-id="com.spmisha134.skillops.CodexGroup" anchor="last"/>
        </action>
        <action id="com.spmisha134.skillops.ShowClaudeRunInsights"
                class="com.spmisha134.skillops.actions.ShowClaudeRunInsightsAction"
                text="Show Run Insights"
                description="Show token usage and efficiency metrics from recent local Claude sessions."
                icon="com.spmisha134.skillops.ui.icons.SkillOpsIcons.ACTION">
            <add-to-group group-id="com.spmisha134.skillops.ClaudeGroup" anchor="last"/>
        </action>
        <action id="com.spmisha134.skillops.ShowGeminiRunInsights"
                class="com.spmisha134.skillops.actions.ShowGeminiRunInsightsAction"
                text="Show Run Insights"
                description="Show token usage and efficiency metrics from recent local Gemini CLI sessions."
                icon="com.spmisha134.skillops.ui.icons.SkillOpsIcons.ACTION">
            <add-to-group group-id="com.spmisha134.skillops.GeminiGroup" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
